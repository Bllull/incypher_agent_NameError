# Copy this file to .env and fill in the values. Never commit .env.
IN_CYPHER_DOCKER_PLATFORM_AVAILABLE=false
# Arena-injected aliases are also accepted: CTF_TOKEN/CTFD_TOKEN and CTF_BASE/CTFD_URL.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=
OPENROUTER_API_KEY=
# Optional; defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
OPENROUTER_HTTP_REFERER=
CTFD_API_TOKEN=
PLATFORM_URL=https://hackathon.in-cypher.com
TEAM_KEY=
# Optional remote log portal, for example https://<username>.pythonanywhere.com
LOG_PORTAL_URL=
LOG_PORTAL_TOKEN=
